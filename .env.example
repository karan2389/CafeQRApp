# Courista — Cafe QR Ordering System (Ember & Oak)
# Environment Configuration Template
# Copy this file to .env.local for local development.

# -----------------------------------------------------------------------------
# 1. Convex Backend Configuration
# -----------------------------------------------------------------------------
# Deployment identifier used by Convex CLI (e.g., dev:outgoing-perch-487 or prod:your-deployment)
CONVEX_DEPLOYMENT=''

# Convex Public Client URL (Browser-accessible, e.g., https://outgoing-perch-487.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=''

# Convex HTTP Actions Site URL (Used for HTTP actions, e.g., https://outgoing-perch-487.convex.site)
NEXT_PUBLIC_CONVEX_SITE_URL=''

# Server-to-Convex Authentication Secret (Keep secret! NEVER expose to client/browser)
# Must match CONVEX_SERVER_SECRET configured in Convex cloud environment
CONVEX_SERVER_SECRET=''

# -----------------------------------------------------------------------------
# 2. Cloudflare R2 Image Storage
# -----------------------------------------------------------------------------
# Cloudflare Account ID
R2_ACCOUNT_ID=''

# Cloudflare R2 Bucket Name (e.g., cafeqr)
R2_BUCKET_NAME=''

# Cloudflare R2 Access Key ID (Server-only)
R2_ACCESS_KEY_ID=''

# Cloudflare R2 Secret Access Key (Server-only! NEVER expose to client/browser)
R2_SECRET_ACCESS_KEY=''

# Public CDN / Custom Domain URL for R2 bucket assets (e.g., https://pub-xxxxxx.r2.dev or https://assets.yourdomain.com)
R2_PUBLIC_URL=''

# -----------------------------------------------------------------------------
# 3. Application Settings
# -----------------------------------------------------------------------------
# Base URL of the web application (e.g., https://courista.yourdomain.com or http://localhost:3000)
NEXT_PUBLIC_APP_URL='http://localhost:3000'
