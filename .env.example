# Cafe QR Ordering System - Environment Configuration
# Duplicate this file to .env.local for local overrides.

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Public client credentials (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=''
NEXT_PUBLIC_SUPABASE_ANON_KEY= ''

# Privileged server-side key (NEVER expose to client/browser)
SUPABASE_SERVICE_ROLE_KEY=''

# -----------------------------------------------------------------------------
# Cloudflare R2 Image Storage
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=''
R2_BUCKET_NAME=''
R2_ACCESS_KEY_ID=''
R2_SECRET_ACCESS_KEY=''
R2_PUBLIC_URL=''

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Convex Backend Configuration
# -----------------------------------------------------------------------------
# Deployment identifier used by Convex CLI (e.g., dev:example-cafe or anonymous:local)
CONVEX_DEPLOYMENT=''

# Convex Client URL (publicly accessible in browser)
NEXT_PUBLIC_CONVEX_URL=''

# Convex HTTP Actions URL (for webhooks, auth, and HTTP endpoints)
NEXT_PUBLIC_CONVEX_SITE_URL=''

CONVEX_SERVER_SECRET= ''